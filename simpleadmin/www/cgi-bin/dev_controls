#!/bin/bash
# dev_controls
# Ensure this file is executable: chmod +x dev_controls

# --- Parse query parameters ---
action=""
port=""
if [ -n "$QUERY_STRING" ]; then
  IFS='&' read -ra params <<< "$QUERY_STRING"
  for param in "${params[@]}"; do
    case $param in
      action=*) action="${param#*=}" ;;
      port=*) port="${param#*=}" ;;
    esac
  done
fi

# If method is POST and action==upload_key, read key content from stdin.
uploaded_key=""
if [ "$REQUEST_METHOD" = "POST" ] && [ "$action" = "upload_key" ]; then
  read -N "${CONTENT_LENGTH:-0}" uploaded_key
fi

# Set Content-Type header.
if [ -z "$action" ]; then
  echo "Content-Type: text/html"
else
  echo "Content-Type: application/json"
fi
echo ""

# --- Define required paths ---
SUDO="/opt/bin/sudo"
SYSTEMCTL="/bin/systemctl"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE="$TAILSCALE_DIR/tailscale"

# --- Helper: Get SSH status ---
get_ssh_status() {
  # Try both "sshd" and "ssh" as service names.
  if $SYSTEMCTL is-active sshd >/dev/null 2>&1; then
    ssh_running=true
  elif $SYSTEMCTL is-active ssh >/dev/null 2>&1; then
    ssh_running=true
  else
    ssh_running=false
  fi
  ssh_port=22
  if grep -qE '^[[:space:]]*Port ' /etc/ssh/sshd_config; then
    ssh_port=$(grep -E '^[[:space:]]*Port ' /etc/ssh/sshd_config | tail -n1 | sed 's/^[#[:space:]]*Port //')
  fi
  echo "{\"enabled\": $ssh_running, \"port\": $ssh_port}"
}

# --- Helper: Sanitize output (replace newlines and escape quotes) ---
sanitize() {
  echo "$1" | tr '\n\r' ' ' | sed 's/"/\\"/g'
}

# --- Helper: Get Tailscale status using --json if possible ---
get_tailscale_status() {
  ts_json=$($SUDO $TAILSCALE status --json 2>/dev/null)
  ts_connected=false
  ts_status="Stopped"
  ts_loginURL=""
  ts_peers="[]"
  if [ -n "$ts_json" ]; then
    # Attempt to parse the JSON output.
    backendState=$(echo "$ts_json" | sed -n 's/.*"BackendState":"\([^"]*\)".*/\1/p')
    if [ "$backendState" = "NeedsLogin" ]; then
      ts_status="Needs Login"
      ts_connected=false
      ts_loginURL=$(echo "$ts_json" | sed -n 's/.*"AuthURL":"\([^"]*\)".*/\1/p')
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif [ "$backendState" = "Running" ]; then
      ts_status="Connected"
      ts_connected=true
    else
      ts_status="$backendState"
      ts_connected=false
    fi
    # Attempt to extract peers from JSON. (If jq is available, this is more robust.)
    if command -v jq >/dev/null 2>&1; then
      ts_peers=$(echo "$ts_json" | jq '[.Peer[] | {name: .HostName, ip: .TailAddr}]')
    else
      # Fallback to text parsing: each line starting with 100.
      peers=""
      while IFS= read -r line; do
        ip=$(echo "$line" | awk '{print $1}')
        name=$(echo "$line" | awk '{print $2}')
        if [[ "$ip" =~ ^100\. ]]; then
          peers+="{\"name\":\"$name\",\"ip\":\"$ip\"},"
        fi
      done <<< "$(echo "$ts_json" | grep '^100\.' )"
      peers=${peers%,}
      if [ -n "$peers" ]; then
        ts_peers="[$peers]"
      fi
    fi
    safe_output=$(sanitize "$ts_json")
  else
    # Fallback: use plain text output.
    ts_output=$($SUDO $TAILSCALE status 2>&1)
    safe_output=$(sanitize "$ts_output")
    if echo "$ts_output" | grep -q "Login URL:"; then
      ts_status="Needs Login"
      ts_connected=false
      ts_loginURL=$(echo "$ts_output" | grep "Login URL:" | sed 's/.*Login URL: //')
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif echo "$ts_output" | grep -q "Logged out"; then
      ts_status="Logged out"
      ts_connected=false
    else
      ts_status="Connected"
      ts_connected=true
      # Parse peers from text output.
      peers=""
      while IFS= read -r line; do
        ip=$(echo "$line" | awk '{print $1}')
        name=$(echo "$line" | awk '{print $2}')
        if [[ "$ip" =~ ^100\. ]]; then
          peers+="{\"name\":\"$name\",\"ip\":\"$ip\"},"
        fi
      done <<< "$(echo "$ts_output" | grep '^100\.')"
      peers=${peers%,}
      if [ -n "$peers" ]; then
        ts_peers="[$peers]"
      fi
    fi
  fi
  echo "{\"connected\": $ts_connected, \"statusText\": \"$ts_status\", \"loginURL\": \"$ts_loginURL\", \"output\": \"$safe_output\", \"peers\": $ts_peers}"
}

# --- SSH Key Management Functions ---
list_keys() {
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ -f "$AUTH_FILE" ]; then
    keys_json="["
    first=true
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      escaped=$(echo "$line" | sed 's/"/\\"/g')
      if [ "$first" = true ]; then
        first=false
      else
        keys_json+=","
      fi
      keys_json+="\"$escaped\""
    done < "$AUTH_FILE"
    keys_json+="]"
    echo "{\"keys\": $keys_json}"
  else
    echo "{\"keys\": []}"
  fi
}

remove_key() {
  index="$port"  # use 'port' parameter as key index
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ ! -f "$AUTH_FILE" ]; then
    echo "{\"error\": \"Authorized keys file not found\"}"
    exit 0
  fi
  newfile=$(mktemp)
  current_index=0
  while IFS= read -r line; do
    if [ "$current_index" -ne "$index" ]; then
      echo "$line" >> "$newfile"
    fi
    current_index=$((current_index + 1))
  done < "$AUTH_FILE"
  mv "$newfile" "$AUTH_FILE"
  echo "{\"status\": \"Key removed\"}"
}

# --- Main Command Dispatcher ---
case "$action" in
  "ssh_status")
    get_ssh_status
    ;;
  "ssh_enable")
    # Try starting "sshd" then "ssh" if necessary.
    if ! $SYSTEMCTL start sshd 2>/dev/null; then
      $SYSTEMCTL start ssh 2>/dev/null
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH enabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_disable")
    if ! $SYSTEMCTL stop sshd 2>/dev/null; then
      $SYSTEMCTL stop ssh 2>/dev/null
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH disabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_change_port")
    if [ -n "$port" ]; then
      if grep -qE '^[[:space:]]*Port ' /etc/ssh/sshd_config; then
        sed -i -E "s/^[#[:space:]]*Port .*/Port $port/" /etc/ssh/sshd_config
      else
        echo "Port $port" >> /etc/ssh/sshd_config
      fi
      if ! $SYSTEMCTL restart sshd 2>/dev/null; then
        $SYSTEMCTL restart ssh 2>/dev/null
      fi
      sleep 1
      ssh_json=$(get_ssh_status)
      echo "{\"status\": \"SSH port changed to $port\", \"ssh\": $ssh_json}"
    else
      echo '{"error": "Port not provided"}'
    fi
    ;;
  "upload_key")
    if [ -n "$uploaded_key" ]; then
      mkdir -p /root/.ssh && chmod 700 /root/.ssh
      echo "$uploaded_key" >> /root/.ssh/authorized_keys
      chmod 600 /root/.ssh/authorized_keys
      echo "{\"status\": \"SSH public key uploaded\"}"
    else
      echo '{"error": "No key provided"}'
    fi
    ;;
  "list_keys")
    list_keys
    ;;
  "remove_key")
    if [ -n "$port" ]; then
      remove_key
    else
      echo '{"error": "Key index not provided"}'
    fi
    ;;
  "tailscale_status")
    get_tailscale_status
    ;;
  "tailscale_up")
    TS_OUT=$($SUDO $TAILSCALE up --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_up_ssh")
    TS_OUT=$($SUDO $TAILSCALE up --ssh --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up with SSH\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_down")
    TS_OUT=$($SUDO $TAILSCALE down 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale down\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_logout")
    TS_OUT=$($SUDO $TAILSCALE logout 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale logged out\", \"tailscale\": $ts_json}"
    ;;
  "all_status")
    ssh_json=$(get_ssh_status)
    ts_json=$(get_tailscale_status)
    echo "{\"ssh\": $ssh_json, \"tailscale\": $ts_json}"
    ;;
  *)
    echo '{"error": "Unknown action"}'
    ;;
esac

exit 0
