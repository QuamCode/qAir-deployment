#!/bin/bash
# dev_controls
# Ensure this file is executable: chmod +x dev_controls

# --- Parse query parameters ---
action=""
param=""
if [ -n "$QUERY_STRING" ]; then
  IFS='&' read -ra params <<< "$QUERY_STRING"
  for p in "${params[@]}"; do
    case $p in
      action=*) action="${p#*=}" ;;
      port=*) param="${p#*=}" ;;
    esac
  done
fi

# If method is POST and action==upload_key, read key content from STDIN.
uploaded_key=""
if [ "$REQUEST_METHOD" = "POST" ] && [ "$action" = "upload_key" ]; then
  read -N "${CONTENT_LENGTH:-0}" uploaded_key
fi

# --- Output HTTP header ---
if [ -z "$action" ]; then
  echo "Content-Type: text/html"
else
  echo "Content-Type: application/json"
fi
echo ""

# --- Define paths (adjust as needed) ---
SUDO="/opt/bin/sudo"
SYSTEMCTL="/bin/systemctl"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE="$TAILSCALE_DIR/tailscale"

# --- Helper: Get SSH status ---
get_ssh_status() {
  ssh_running=$($SYSTEMCTL is-active sshd 2>/dev/null)
  if [ "$ssh_running" != "active" ]; then
    # fallback: check for sshd process
    if pidof sshd >/dev/null 2>&1; then
      enabled=true
    else
      enabled=false
    fi
  else
    enabled=true
  fi
  port=$(grep -E '^[[:space:]]*Port ' /etc/ssh/sshd_config | tail -n1 | sed 's/^[#[:space:]]*Port //')
  if [ -z "$port" ]; then port="22"; fi
  echo "{\"enabled\": $enabled, \"port\": \"$port\"}"
}

# --- Helper: Sanitize output (replace newlines and escape quotes) ---
sanitize() {
  echo "$1" | tr '\n\r' ' ' | sed 's/"/\\"/g'
}

# --- Helper: Get Tailscale status ---
get_tailscale_status() {
  # Try JSON output from tailscale status:
  ts_json=$($SUDO $TAILSCALE status --json 2>/dev/null)
  first_char=$(echo "$ts_json" | cut -c1)
  if [ "$first_char" = "{" ]; then
    backendState=$(echo "$ts_json" | sed -n 's/.*"BackendState":"\([^"]*\)".*/\1/p')
    if [ "$backendState" = "NeedsLogin" ]; then
      connected=false
      statusText="Needs Login"
      ts_loginURL=$(echo "$ts_json" | sed -n 's/.*"AuthURL":"\([^"]*\)".*/\1/p')
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif [ "$backendState" = "Running" ]; then
      connected=true
      statusText="Connected"
      ts_loginURL=""
    else
      connected=false
      statusText="$backendState"
      ts_loginURL=""
    fi
    safe_output=$(sanitize "$ts_json")
    # Extract peers with jq if available
    if command -v jq >/dev/null 2>&1; then
      ts_peers=$(echo "$ts_json" | jq '[.Peer[] | {name:.HostName, ip:.TailAddr}]')
    else
      ts_peers="[]"
    fi
  else
    # Fallback to plain text output.
    ts_text=$($SUDO $TAILSCALE status 2>&1)
    safe_output=$(sanitize "$ts_text")
    if echo "$ts_text" | grep -q "Login URL:"; then
      connected=false
      statusText="Needs Login"
      ts_loginURL=$(echo "$ts_text" | grep "Login URL:" | sed 's/.*Login URL: //')
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif echo "$ts_text" | grep -q "Logged out"; then
      connected=false
      statusText="Logged out"
      ts_loginURL=""
    else
      connected=true
      statusText="Connected"
      ts_loginURL=""
    fi
    ts_peers="[]"
  fi
  echo "{\"connected\": $connected, \"statusText\": \"$statusText\", \"loginURL\": \"$ts_loginURL\", \"output\": \"$safe_output\", \"peers\": $ts_peers}"
}

# --- SSH Key Management Functions ---
list_keys() {
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ -f "$AUTH_FILE" ]; then
    keys_json="["
    first=true
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      escaped=$(echo "$line" | sed 's/"/\\"/g')
      if [ "$first" = true ]; then
        first=false
      else
        keys_json+="," 
      fi
      keys_json+="\"$escaped\""
    done < "$AUTH_FILE"
    keys_json+="]"
    echo "{\"keys\": $keys_json}"
  else
    echo "{\"keys\": []}"
  fi
}

remove_key() {
  index="$param"  # using 'param' as key index
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ ! -f "$AUTH_FILE" ]; then
    echo "{\"error\": \"Authorized keys file not found\"}"
    exit 0
  fi
  newfile=$(mktemp)
  current_index=0
  while IFS= read -r line; do
    if [ "$current_index" -ne "$index" ]; then
      echo "$line" >> "$newfile"
    fi
    current_index=$((current_index + 1))
  done < "$AUTH_FILE"
  mv "$newfile" "$AUTH_FILE"
  echo "{\"status\": \"Key removed\"}"
}

# --- Main Command Dispatcher ---
case "$action" in
  "ssh_status")
    get_ssh_status
    ;;
  "ssh_enable")
    if ! $SYSTEMCTL start sshd 2>/dev/null; then
      $SYSTEMCTL start ssh 2>/dev/null
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH enabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_disable")
    if ! $SYSTEMCTL stop sshd 2>/dev/null; then
      $SYSTEMCTL stop ssh 2>/dev/null
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH disabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_change_port")
    if [ -n "$param" ]; then
      if grep -qE '^[[:space:]]*Port ' /etc/ssh/sshd_config; then
        sed -i -E "s/^[#[:space:]]*Port .*/Port $param/" /etc/ssh/sshd_config
      else
        echo "Port $param" >> /etc/ssh/sshd_config
      fi
      if ! $SYSTEMCTL restart sshd 2>/dev/null; then
        $SYSTEMCTL restart ssh 2>/dev/null
      fi
      sleep 1
      ssh_json=$(get_ssh_status)
      echo "{\"status\": \"SSH port changed to $param\", \"ssh\": $ssh_json}"
    else
      echo '{"error": "Port not provided"}'
    fi
    ;;
  "upload_key")
    if [ -n "$uploaded_key" ]; then
      mkdir -p /root/.ssh && chmod 700 /root/.ssh
      echo "$uploaded_key" >> /root/.ssh/authorized_keys
      chmod 600 /root/.ssh/authorized_keys
      echo "{\"status\": \"SSH public key uploaded\"}"
    else
      echo '{"error": "No key provided"}'
    fi
    ;;
  "list_keys")
    list_keys
    ;;
  "remove_key")
    if [ -n "$param" ]; then
      remove_key
    else
      echo '{"error": "Key index not provided"}'
    fi
    ;;
  "tailscale_status")
    get_tailscale_status
    ;;
  "tailscale_up")
    # Run tailscale up without forcing reauth.
    TS_OUT=$($SUDO $TAILSCALE up --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_login")
    # New action: force reauthentication so AuthURL is generated.
    TS_OUT=$($SUDO $TAILSCALE up --force-reauth --json 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale login initiated\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_up_ssh")
    TS_OUT=$($SUDO $TAILSCALE up --ssh --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up with SSH\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_down")
    TS_OUT=$($SUDO $TAILSCALE down 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale down\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_logout")
    TS_OUT=$($SUDO $TAILSCALE logout 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale logged out\", \"tailscale\": $ts_json}"
    ;;
  "all_status")
    ssh_json=$(get_ssh_status)
    ts_json=$(get_tailscale_status)
    echo "{\"ssh\": $ssh_json, \"tailscale\": $ts_json}"
    ;;
  *)
    echo '{"error": "Unknown action"}'
    ;;
esac

exit 0
