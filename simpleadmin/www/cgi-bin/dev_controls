#!/bin/bash
# dev_controls
# Ensure this file is executable: chmod +x dev_controls

# --- Parse query parameters ---
action=""
param=""
if [ -n "$QUERY_STRING" ]; then
  IFS='&' read -ra params <<< "$QUERY_STRING"
  for p in "${params[@]}"; do
    case $p in
      action=*) action="${p#*=}" ;;
      port=*) param="${p#*=}" ;;
    esac
  done
fi

# If POST and action==upload_key, read key data from STDIN.
uploaded_key=""
if [ "$REQUEST_METHOD" = "POST" ] && [ "$action" = "upload_key" ]; then
  read -N "${CONTENT_LENGTH:-0}" uploaded_key
fi

# --- Output HTTP header ---
if [ -z "$action" ]; then
  echo "Content-Type: text/html"
else
  echo "Content-Type: application/json"
fi
echo ""

# --- Define paths (adjust as needed) ---
SUDO="/opt/bin/sudo"
JQBINARY="/opt/bin/jq"
SYSTEMCTL="/bin/systemctl"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE="$TAILSCALE_DIR/tailscale"

# --- Helper: Get SSH status ---
get_ssh_status() {
  if $SYSTEMCTL is-active sshd >/dev/null 2>&1; then
    enabled=true
  elif $SYSTEMCTL is-active ssh >/dev/null 2>&1; then
    enabled=true
  elif pidof sshd >/dev/null 2>&1; then
    enabled=true
  else
    enabled=false
  fi
  ssh_port=$(grep -E '^[[:space:]]*Port ' /etc/ssh/sshd_config | tail -n1 | sed 's/^[#[:space:]]*Port //')
  [ -z "$ssh_port" ] && ssh_port="22"

  # Get authentication method
  auth_method="both"
  if grep -qE '^[[:space:]]*PasswordAuthentication[[:space:]]+no' /etc/ssh/sshd_config; then
    auth_method="pubkey"
  elif grep -qE '^[[:space:]]*PubkeyAuthentication[[:space:]]+no' /etc/ssh/sshd_config; then
    auth_method="password"
  fi

  echo "{\"enabled\": $enabled, \"port\": \"$ssh_port\", \"authMethod\": \"$auth_method\"}"
}

# --- Helper: Set SSH authentication method ---
set_ssh_auth() {
  method="$1"
  case "$method" in
    "password")
      $SUDO sed -i -E 's/^[#[:space:]]*PasswordAuthentication[[:space:]]+.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
      $SUDO sed -i -E 's/^[#[:space:]]*PubkeyAuthentication[[:space:]]+.*/PubkeyAuthentication no/' /etc/ssh/sshd_config
      ;;
    "pubkey")
      $SUDO sed -i -E 's/^[#[:space:]]*PasswordAuthentication[[:space:]]+.*/PasswordAuthentication no/' /etc/ssh/sshd_config
      $SUDO sed -i -E 's/^[#[:space:]]*PubkeyAuthentication[[:space:]]+.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
      ;;
    "both")
      $SUDO sed -i -E 's/^[#[:space:]]*PasswordAuthentication[[:space:]]+.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
      $SUDO sed -i -E 's/^[#[:space:]]*PubkeyAuthentication[[:space:]]+.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
      ;;
    *)
      echo '{"error": "Invalid authentication method"}' && exit 1
      ;;
  esac

  # Restart SSH service to apply changes
  if ! $SUDO $SYSTEMCTL restart sshd 2>/dev/null; then
    if ! service sshd restart 2>/dev/null; then
      echo '{"error": "Failed to restart sshd"}' && exit 1
    fi
  fi

  sleep 1
  ssh_json=$(get_ssh_status)
  echo "{\"status\": \"SSH authentication method set to $method\", \"ssh\": $ssh_json}"
}

# --- Helper: Sanitize output ---
sanitize() {
  echo "$1" | tr '\n\r' ' ' | sed 's/"/\\"/g'
}

# --- Helper: Get Tailscale status ---
get_tailscale_status() {
  # First, check if a valid Tailscale IP is present.
  ts_ip=$($SUDO $TAILSCALE ip -4 2>/dev/null | tr -d '[:space:]')
  if [ -n "$ts_ip" ]; then
    ip_connected=true
  else
    ip_connected=false
  fi

  # Retrieve status in JSON format.
  ts_json=$($SUDO $TAILSCALE status --json 2>/dev/null)
  first_char=$(echo "$ts_json" | cut -c1)
  if [ "$first_char" = "{" ]; then
    backendState=$(echo "$ts_json" | sed -n 's/.*"BackendState":"\([^"]*\)".*/\1/p')
    if [ "$backendState" = "NeedsLogin" ]; then
      connected=false
      statusText="Needs Login"
      ts_loginURL=$(echo "$ts_json" | sed -n 's/.*"AuthURL":"\([^"]*\)".*/\1/p')
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif [ "$backendState" = "Running" ]; then
      if $ip_connected; then
        connected=true
        statusText="Connected"
      else
        connected=false
        statusText="Stopped"
      fi
      ts_loginURL=""
    else
      connected=false
      statusText="$backendState"
      ts_loginURL=""
    fi
      ts_peers=$(echo "$ts_json" | $JQBINARY '[.Peer[] | {id: .ID, name: .HostName, online: .Online, tailscale_ips: .TailscaleIPs, allowed_ips: .AllowedIPs, os: .OS, last_seen: .LastSeen}]')
      if [ -z "$ts_peers" ]; then
        ts_peers="[]"
      fi
  else
    # Fallback to text output.
    ts_text=$($SUDO $TAILSCALE status 2>/dev/null)
    safe_output=$(sanitize "$ts_text")
    if echo "$ts_text" | grep -q "Login URL:"; then
      connected=false
      statusText="Needs Login"
      ts_loginURL=$(echo "$ts_text" | grep -o "https://[^ ]*")
      ts_loginURL=$(sanitize "$ts_loginURL")
    elif echo "$ts_text" | grep -q "Logged out"; then
      connected=false
      statusText="Logged out"
      ts_loginURL=$(echo "$ts_text" | grep -o "https://[^ ]*")
      ts_loginURL=$(sanitize "$ts_loginURL")
    else
      if echo "$safe_output" | grep -q "100\."; then
        connected=true
        statusText="Connected"
      else
        connected=false
        statusText="Stopped"
      fi
      ts_loginURL=""
    fi
      ts_peers=$(echo "$ts_json" | $JQBINARY '[.Peer[] | {id: .ID, name: .HostName, online: .Online, tailscale_ips: .TailscaleIPs, allowed_ips: .AllowedIPs, os: .OS, last_seen: .LastSeen}]')
      if [ -z "$ts_peers" ]; then
        ts_peers="[]"
      fi
  fi

  echo "{\"connected\": $connected, \"statusText\": \"$statusText\", \"loginURL\": \"$ts_loginURL\", \"output\": \"$safe_output\", \"peers\": $ts_peers}"
}

# --- SSH Key Management Functions ---
list_keys() {
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ -f "$AUTH_FILE" ]; then
    keys_json="["
    first=true
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      escaped=$(echo "$line" | sed 's/"/\\"/g')
      if [ "$first" = true ]; then
        first=false
      else
        keys_json+=","
      fi
      keys_json+="\"$escaped\""
    done < "$AUTH_FILE"
    keys_json+="]"
    echo "{\"keys\": $keys_json}"
  else
    echo "{\"keys\": []}"
  fi
}

remove_key() {
  index="$param"
  AUTH_FILE="/root/.ssh/authorized_keys"
  if [ ! -f "$AUTH_FILE" ]; then
    echo "{\"error\": \"Authorized keys file not found\"}"
    exit 0
  fi
  newfile=$(mktemp)
  current_index=0
  while IFS= read -r line; do
    if [ "$current_index" -ne "$index" ]; then
      echo "$line" >> "$newfile"
    fi
    current_index=$((current_index + 1))
  done < "$AUTH_FILE"
  mv "$newfile" "$AUTH_FILE"
  echo "{\"status\": \"Key removed\"}"
}

# --- Main Command Dispatcher ---
case "$action" in
  "ssh_status")
    get_ssh_status
    ;;
  "ssh_enable")
    if ! $SUDO $SYSTEMCTL start sshd 2>/dev/null; then
      if ! service sshd start 2>/dev/null; then
        echo "{\"error\": \"Failed to start sshd\"}" && exit 1
      fi
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH enabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_disable")
    if ! $SUDO $SYSTEMCTL stop sshd 2>/dev/null; then
      if ! service sshd stop 2>/dev/null; then
        echo "{\"error\": \"Failed to stop sshd\"}" && exit 1
      fi
    fi
    sleep 1
    ssh_json=$(get_ssh_status)
    echo "{\"status\": \"SSH disabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_change_port")
    if [ -n "$param" ]; then
      if $SUDO grep -qE '^[[:space:]]*Port ' /etc/ssh/sshd_config; then
        $SUDO sed -i -E "s/^[#[:space:]]*Port .*/Port $param/" /etc/ssh/sshd_config
      else
        $SUDO sh -c "echo 'Port $param' >> /etc/ssh/sshd_config"
      fi
      if ! $SUDO $SYSTEMCTL restart sshd 2>/dev/null; then
        if ! service sshd restart 2>/dev/null; then
          echo "{\"error\": \"Failed to restart sshd\"}" && exit 1
        fi
      fi
      sleep 1
      ssh_json=$(get_ssh_status)
      echo "{\"status\": \"SSH port changed to $param\", \"ssh\": $ssh_json}"
    else
      echo '{"error": "Port not provided"}'
    fi
    ;;
  "ssh_set_auth")
    if [ -n "$param" ]; then
      set_ssh_auth "$param"
    else
      echo '{"error": "Authentication method not provided"}' && exit 1
    fi
    ;;
  "upload_key")
    if [ -n "$uploaded_key" ]; then
      # Ensure .ssh directory exists with correct permissions
      if ! mkdir -p /root/.ssh 2>/dev/null; then
        echo '{"error": "Failed to create .ssh directory"}' && exit 1
      fi
      
      # Set correct permissions
      if ! chmod 700 /root/.ssh 2>/dev/null; then
        echo '{"error": "Failed to set .ssh directory permissions"}' && exit 1
      fi
      
      # Validate key format
      if ! echo "$uploaded_key" | grep -qE '^(ssh-(rsa|dss|ed25519)|ecdsa-sha2-nistp[0-9]+)'; then
        echo '{"error": "Invalid key format"}' && exit 1
      fi
      
      # Check if key already exists
      if [ -f /root/.ssh/authorized_keys ] && grep -Fxq "$uploaded_key" /root/.ssh/authorized_keys; then
        echo '{"error": "Key already exists"}' && exit 1
      fi
      
      # Append key to authorized_keys
      if ! echo "$uploaded_key" >> /root/.ssh/authorized_keys; then
        echo '{"error": "Failed to write key"}' && exit 1
      fi
      
      # Set correct permissions on authorized_keys
      if ! chmod 600 /root/.ssh/authorized_keys; then
        echo '{"error": "Failed to set key file permissions"}' && exit 1
      fi
      
      echo "{\"status\": \"SSH public key uploaded\"}"
    else
      echo '{"error": "No key provided"}'
    fi
    ;;
  "list_keys")
    list_keys
    ;;
  "remove_key")
    if [ -n "$param" ]; then
      remove_key
    else
      echo '{"error": "Key index not provided"}'
    fi
    ;;
  "clear_all_keys")
    AUTH_FILE="/root/.ssh/authorized_keys"
    if [ -f "$AUTH_FILE" ]; then
      > "$AUTH_FILE"
      echo "{\"status\": \"All keys removed\"}"
    else
      echo "{\"error\": \"Authorized keys file not found\"}"
    fi
    ;;
  "tailscale_status")
    get_tailscale_status
    ;;
  "tailscale_up")
    TS_OUT=$($SUDO $TAILSCALE up --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_login")
    # Force reauthentication to generate an AuthURL.
    TS_OUT=$($SUDO $TAILSCALE up --force-reauth --json 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale login initiated\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_up_ssh")
    TS_OUT=$($SUDO $TAILSCALE up --ssh --accept-dns=false --reset 2>&1)
    sleep 1
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale up with SSH\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_down")
    TS_OUT=$($SUDO $TAILSCALE down 2>&1)
    sleep 2
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale down\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_logout")
    TS_OUT=$($SUDO $TAILSCALE logout 2>&1)
    sleep 2
    ts_json=$(get_tailscale_status)
    echo "{\"status\": \"Tailscale logged out\", \"tailscale\": $ts_json}"
    ;;
  "tailscale_netcheck")
    if [ -n "$($SUDO $TAILSCALE status 2>/dev/null)" ]; then
      TS_OUT=$($SUDO $TAILSCALE netcheck 2>&1)
      ts_json=$(get_tailscale_status)
      echo "{\"status\": \"Network check completed\", \"output\": \"$TS_OUT\", \"tailscale\": $ts_json}"
    else
      echo '{"error": "Tailscale is not running"}'
    fi
    ;;
  "tailscale_ping")
    if [ -n "$($SUDO $TAILSCALE status 2>/dev/null)" ]; then
      # Extract parameters
      count=4
      verbose=""
      if [ -n "$param" ]; then
        if echo "$param" | grep -q "count="; then
          count=$(echo "$param" | sed 's/.*count=\([0-9]*\).*/\1/')
        fi
        if echo "$param" | grep -q "verbose=true"; then
          verbose="--verbose"
        fi
        # Extract the actual IP/hostname to ping
        target=$(echo "$param" | sed 's/\([^&]*\).*/\1/')
      else
        echo '{"error": "No target specified"}' && exit 1
      fi

      # Run ping and capture output
      TS_OUT=$($SUDO $TAILSCALE ping -c "$count" $verbose "$target" 2>&1)
      
      # Properly escape the output for JSON
      TS_OUT=$(echo "$TS_OUT" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\n/\\n/g' -e 's/\r//g' -e 's/\t/\\t/g')
      
      # Get status
      ts_json=$(get_tailscale_status)
      
      # Output JSON with properly escaped ping output
      echo "{\"status\": \"Ping completed\", \"output\": \"$TS_OUT\", \"tailscale\": $ts_json}" | tr -d '\n'
    else
      echo '{"error": "Tailscale is not running"}'
    fi
    ;;
  "tailscale_debug")
    if [ -n "$($SUDO $TAILSCALE status 2>/dev/null)" ]; then
      TS_OUT=$($SUDO $TAILSCALE debug --json 2>&1)
      ts_json=$(get_tailscale_status)
      echo "{\"status\": \"Debug info retrieved\", \"output\": \"$TS_OUT\", \"tailscale\": $ts_json}"
    else
      echo '{"error": "Tailscale is not running"}'
    fi
    ;;
  "tailscale_restart")
    if $SUDO $SYSTEMCTL restart tailscaled 2>/dev/null; then
      sleep 2
      ts_json=$(get_tailscale_status)
      echo "{\"status\": \"Tailscale service restarted\", \"tailscale\": $ts_json}"
    else
      echo '{"error": "Failed to restart Tailscale service"}'
    fi
    ;;
  "tailscale_prefs")
    if [ -n "$($SUDO $TAILSCALE status 2>/dev/null)" ]; then
      TS_OUT=$($SUDO $TAILSCALE prefs 2>&1)
      ts_json=$(get_tailscale_status)
      echo "{\"status\": \"Preferences retrieved\", \"output\": \"$TS_OUT\", \"tailscale\": $ts_json}"
    else
      echo '{"error": "Tailscale is not running"}'
    fi
    ;;
  "all_status")
    ssh_json=$(get_ssh_status)
    ts_json=$(get_tailscale_status)
    echo "{\"ssh\": $ssh_json, \"tailscale\": $ts_json}"
    ;;
  *)
    echo '{"error": "Unknown action"}'
    ;;
esac

exit 0
