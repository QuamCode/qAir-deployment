#!/bin/bash
# dev_controls.cgi
# Ensure this file is executable: chmod +x dev_controls.cgi

echo "Content-type: application/json"
echo ""

# Define bin paths – adjust SUDO if necessary!
SUDO="/opt/bin/sudo"
SYSTEMCTL="/bin/systemctl"
TAILSCALE_DIR="/usrdata/tailscale"
TAILSCALE="$TAILSCALE_DIR/tailscale"

# Parse query parameters safely from QUERY_STRING
ACTION=$(echo "$QUERY_STRING" | sed -n 's/.*action=\([^&]*\).*/\1/p')
PORT=$(echo "$QUERY_STRING" | sed -n 's/.*port=\([^&]*\).*/\1/p')

# Function to check SSH status and current port.
ssh_status() {
    status=$($SUDO $SYSTEMCTL is-active sshd 2>/dev/null)
    if [ "$status" = "active" ]; then
        running=true
    else
        running=false
    fi
    # Grab the first non-comment Port line from sshd_config.
    ssh_port=$(grep -E '^[[:space:]]*Port ' /etc/ssh/sshd_config | grep -v '^[[:space:]]*#' | head -n 1 | awk '{print $2}')
    if [ -z "$ssh_port" ]; then
      ssh_port="22"
    fi
    echo "{\"running\": $running, \"port\": \"$ssh_port\"}"
}

# Function to check Tailscale status.
tailscale_status() {
    # First try the JSON output from Tailscale.
    output_json=$($SUDO $TAILSCALE status --json 2>&1)
    first_char=$(echo "$output_json" | cut -c1)
    if [ "$first_char" = "{" ]; then
         # Valid JSON output; assume tailscale is running.
         echo "{\"running\": true, \"connections\": $output_json}"
         return
    fi

    # Fallback: use plain text parsing.
    output=$($SUDO $TAILSCALE status 2>&1)
    if echo "$output" | grep -q "Login URL:"; then
      # Tailscale is waiting for login.
      running=false
      loginURL=$(echo "$output" | grep "Login URL:" | sed 's/.*Login URL: //')
    elif echo "$output" | grep -q "Logged out"; then
      # Tailscale is logged out.
      running=false
      loginURL=""
    else
      # Tailscale is running normally.
      running=true
      loginURL=""
    fi
    # Escape any quotes in the output and loginURL for valid JSON.
    safe_output=$(echo "$output" | sed 's/"/\\"/g')
    safe_loginURL=$(echo "$loginURL" | sed 's/"/\\"/g')
    echo "{\"running\": $running, \"output\": \"$safe_output\", \"loginURL\": \"$safe_loginURL\"}"
}

# Main command dispatcher.
case "$ACTION" in
  "ssh_status")
    ssh_status
    ;;
  "ssh_disable")
    $SUDO $SYSTEMCTL stop sshd
    sleep 1
    ssh_json=$(ssh_status)
    echo "{\"status\": \"SSH disabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_enable")
    $SUDO $SYSTEMCTL start sshd
    sleep 1
    ssh_json=$(ssh_status)
    echo "{\"status\": \"SSH enabled\", \"ssh\": $ssh_json}"
    ;;
  "ssh_change_port")
    if [ -n "$PORT" ]; then
      # Update only uncommented Port lines in sshd_config.
      sed -i "s/^\([[:space:]]*Port \).*/\1$PORT/" /etc/ssh/sshd_config
      $SUDO $SYSTEMCTL restart sshd
      sleep 1
      ssh_json=$(ssh_status)
      echo "{\"status\": \"SSH port changed to $PORT\", \"ssh\": $ssh_json}"
    else
      echo '{"error": "Port not provided"}'
    fi
    ;;
  "tailscale_status")
    tailscale_status
    ;;
  "tailscale_up")
    output=$($SUDO $TAILSCALE up --accept-dns=false --reset 2>&1)
    sleep 1
    # tailscale_status will pick up any login URL from the output if present.
    tailscale_json=$(tailscale_status)
    echo "{\"status\": \"Tailscale up\", \"tailscale\": $tailscale_json}"
    ;;
  "tailscale_up_ssh")
    output=$($SUDO $TAILSCALE up --ssh --accept-dns=false --reset 2>&1)
    sleep 1
    tailscale_json=$(tailscale_status)
    echo "{\"status\": \"Tailscale up (SSH)\", \"tailscale\": $tailscale_json}"
    ;;
  "tailscale_down")
    output=$($SUDO $TAILSCALE down 2>&1)
    sleep 1
    tailscale_json=$(tailscale_status)
    echo "{\"status\": \"Tailscale down\", \"tailscale\": $tailscale_json}"
    ;;
  "tailscale_logout")
    output=$($SUDO $TAILSCALE logout 2>&1)
    sleep 1
    tailscale_json=$(tailscale_status)
    echo "{\"status\": \"Tailscale logout\", \"tailscale\": $tailscale_json}"
    ;;
  "all_status")
    ssh_json=$(ssh_status)
    tailscale_json=$(tailscale_status)
    echo "{\"ssh\": $ssh_json, \"tailscale\": $tailscale_json}"
    ;;
  *)
    echo '{"error": "Unknown action"}'
    ;;
esac
